{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run dev)",
      "Bash(npm test*)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Write",
      "Edit",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm install*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Bash(cat **/.env*)",
      "Bash(rm -rf *)"
    ]
  }
}
