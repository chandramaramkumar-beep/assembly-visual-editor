@top Program { line* }

line { Statement? newline }

Statement {
  LabelDef Instruction? |
  Instruction
}

LabelDef { Identifier ":" }

Instruction { Mnemonic Operands? }

Operands { operand ("," operand)* }

operand { Register | Number | MemoryRef | Identifier }

MemoryRef { "[" Register (("+" | "-") Number)? "]" }

// Mnemonics and register names are carved out of Identifier rather than declared
// as competing tokens — otherwise a label like `loop_start` tokenizes as the
// mnemonic `loop` followed by `_start`.
Mnemonic {
  @specialize<Identifier,
    "mov" | "lea" | "add" | "sub" | "inc" | "dec" | "imul" | "idiv" | "neg" |
    "and" | "or" | "xor" | "not" | "shl" | "shr" | "cmp" | "test" |
    "jmp" | "je" | "jne" | "jge" | "jle" | "jg" | "jl" | "loop" |
    "push" | "pop" | "call" | "ret" | "nop">
}

Register {
  @specialize<Identifier,
    "rax" | "rbx" | "rcx" | "rdx" | "rsi" | "rdi" | "rbp" | "rsp" |
    "r8" | "r9" | "r10" | "r11" | "r12" | "r13" | "r14" | "r15">
}

@skip { space | Comment }

@tokens {
  space { $[ \t]+ }

  newline { "\n" }

  Comment { ";" ![\n]* }

  Number { "-"? ("0x" $[0-9a-fA-F]+ | $[0-9]+) }

  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }

  "[" "]" "," "+" "-" ":"
}
